"palette.section.body" = "Body";
"palette.section.eye" = "Eyes";
"palette.hint.marking" = "The patches on the head, back and tail. Changing only these already makes a different cat.";
"palette.hint.body" = "The cream coat. Worth touching only for a black cat or a white one.";
"palette.hint.eye" = "The whole eye — the dark rim, the iris and the white catchlight. Raise the dark end and drop the depth for white eyes.";
"palette.hue" = "Colour";
"palette.hueEnd" = "Ends at";
