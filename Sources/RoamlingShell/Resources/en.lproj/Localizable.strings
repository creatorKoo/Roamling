"palette.window.title" = "Roamling Colour";
"palette.header" = "Make Bori your own";
"palette.footer" = "Move a slider and the Bori on screen changes with it, and stays that way. A group you do not touch keeps the drawing exactly as it was — changing the body will not flatten the markings. To undo, press Start over, or pick Pet › Bori › Bori Bori from the menu.";
"palette.section.marking" = "Markings";
"palette.section.body" = "Body";
"palette.section.eye" = "Eyes";
"palette.hint.marking" = "The patches on the head, back and tail. Changing only these already makes a different cat.";
"palette.hint.body" = "The cream coat. Worth touching only for a black cat or a white one.";
"palette.hint.eye" = "The whole eye — the dark rim, the iris and the white catchlight. Raise the dark end and drop the depth for white eyes.";
"palette.hue" = "Colour";
"palette.hueEnd" = "Ends at";
"palette.hint.hueEnd" = "Set this away from Colour and the hue travels from the dark end to the light one. That is how a rainbow is made. Leave them equal for a single colour.";
"palette.dark" = "Dark end";
"palette.light" = "Light end";
"palette.hint.range" = "The two ends of the shading. Spread them for more depth, close them for a flatter look. They cannot cross.";
"palette.chroma" = "Depth";
"palette.hint.chroma" = "Zero is grey; the higher it goes the more colour shows.";
"palette.pick" = "Pick a colour…";
"palette.hint.pick" = "“Pick a colour…” opens the Windows colour picker. What you choose becomes the middle of that part's shading; the dark and light ends follow it, keeping the spread they have now.";
"palette.reset" = "Start over";
"palette.done" = "Close";

/* First-run and feature guide; shared with the Windows native window. */
"menu.usageGuide" = "Bori User Guide…";
"guide.title" = "Meet Bori";
"guide.updates.title" = "What's new with Bori";
"guide.intro" = "A few ways to enjoy your desktop companion.";
"guide.footer" = "You can reopen this guide from the tray or menu bar → Bori User Guide….";
"guide.done" = "Got it";
"guide.modifier.windows" = "Left Ctrl";
"guide.modifier.mac" = "Left ⌘ (Command)";
"guide.catch.title" = "1. Catch and play";
"guide.catch.body" = "Hold %@ as you approach Bori to stop it dodging. Rest the pointer on its body to make hearts appear; move the pointer faster for quicker head tilts. Click and drag its body to move it, then release to put it down.";
"guide.customize.title" = "2. Make it yours";
"guide.customize.body" = "Open the tray or menu bar menu to change Bori's colour and size. Movement settings control roaming, pointer avoidance and catching.";
"guide.work.title" = "3. Keep you company at work";
"guide.work.body" = "Connect Codex or Claude Code from the menu for activity reactions. Visual awareness is optional: it helps Bori choose space away from text.";
"guide.hide.title" = "4. Take a little break";
"guide.hide.body" = "Choose Hide for a while from the menu to get Bori out of the way, then use the same menu to bring it back.";
"guide.changed.catch.title" = "An easier way to catch Bori";
"guide.changed.petting.title" = "Pet Bori with hearts";
"guide.changed.petting.body" = "Hold %@ with the pointer over Bori's body. Keep still for gentle head tilts, or move faster for livelier tilts and more hearts. Bori also tilts its head slowly while waiting for your input.";
"guide.changed.catch.body" = "A body click now works while Bori is moving or working. Hold %@ when approaching to stop it dodging. Ordinary tail wags happen only when seated.";
