# Copy to scripts/signing.env (git-ignored) to sign local builds with a stable
# identity instead of ad-hoc.
#
# Ad-hoc signing pins the app's designated requirement to the binary's cdhash,
# so every rebuild looks like a different app to macOS and any granted
# Accessibility permission is forgotten. Signing with a certificate keeps the
# requirement pointed at that certificate instead, and the grant survives.
#
# A free self-signed certificate is enough:
#   Keychain Access -> Certificate Assistant -> Create a Certificate
#   Certificate Type: Code Signing, Identity Type: Self Signed Root
#   Check "Let me override defaults" to set a validity longer than one year.
#
# Confirm the name with:
#   security find-identity -v -p codesigning

ROAMLING_CODESIGN_IDENTITY="Your Certificate Name"
