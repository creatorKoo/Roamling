"alert.claude.install.title" = "Install Claude Code integration?";
"alert.claude.install.body" = "Roamling will add local lifecycle command hooks to ~/.claude/settings.json.\nExisting settings and hooks are preserved, and a one-time backup is created.\n\nPrompt text, tool input/output, transcripts, and source code are not stored or logged.";
"alert.claude.remove.title" = "Remove Claude Code integration?";
"alert.claude.remove.body" = "Only Roamling's hook handlers will be removed. Other Claude Code settings and hooks stay unchanged.";
"alert.codex.install.title" = "Install Codex integration?";
"alert.codex.install.body" = "Roamling will add local lifecycle command hooks to ~/.codex/hooks.json.\nExisting hooks and config.toml (including notify) are preserved, and a one-time backup is created.\n\nPrompt text, tool input/output, transcripts, and source code are not stored or logged.\nRestart Codex after installation and approve the new hook trust prompt.";
"alert.codex.remove.title" = "Remove Codex integration?";
"alert.codex.remove.body" = "Only Roamling's hook handlers will be removed. Other Codex hooks, config, and notify stay unchanged.";
